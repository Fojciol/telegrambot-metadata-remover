# Telegram Bot Token uzyskany od @BotFather
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz_1234567

# Lista ID użytkowników Telegrama z uprawnieniami (rozdzielona przecinkami)
# Jeśli puste, bot jest dostępny dla każdego (lub wyświetli Twoje ID przy pierwszym kontakcie)
# Przykład: ALLOWED_USER_IDS=123456789,987654321
ALLOWED_USER_IDS=

# Opcjonalne: maksymalny rozmiar pliku w MB (domyślnie 20MB ze względu na Telegram Bot API)
MAX_FILE_SIZE_MB=20

# Opcjonalne: katalog tymczasowy dla plików w trakcie przetwarzania
TEMP_DIR=/tmp/bot_media
